<?xml version="1.0" encoding="utf-8"?>
<!-- "Na żywo" tab (v2) — ambient Live translation, backed by
     LiveTranslationService (Foreground Service). See LiveTabController. -->
<ScrollView
    android:id="@+id/liveRoot"
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/live_label_ambient_language"
            android:textColor="@color/tg_text_secondary"
            android:textSize="12sp" />

        <!-- Static, not a picker — there is no request field that lets
             this app force a source language on Gemini, so the UI must
             not imply one (see LiveTabController's class doc). Reads
             "Automatyczne wykrywanie" until Gemini itself reports a
             detected language, then "Wykryto: <language>". -->
        <TextView
            android:id="@+id/textLiveAmbientLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/tg_text_primary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textLiveTargetLanguage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/tg_text_primary"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card">

            <TextView
                android:id="@+id/textLiveDeviceStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/tg_text_primary"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/textLiveHeadsetHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/tg_text_secondary"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/textLiveState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textColor="@color/tg_primary"
            android:textStyle="bold"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonLiveStartStop"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/live_button_start"
            android:textSize="16sp" />

        <Button
            android:id="@+id/buttonLiveRetry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/live_button_retry"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_label_original_transcript"
                android:textColor="@color/tg_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textLiveInputTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:textColor="@color/tg_text_primary"
                android:textSize="15sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="@color/tg_divider" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/live_label_translation_transcript"
                android:textColor="@color/tg_text_secondary"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textLiveOutputTranscript"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:minHeight="48dp"
                android:textColor="@color/tg_text_primary"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- TEMPORARY diagnostics card — see
             LiveTranslationService's "TEMPORARY diagnostics" section
             (above addStateListener) and LiveTabController.updateDiagnosticsDisplay.
             Measures Gemini Live turn latency and AudioTrack output
             backlog only; delete this card + those two references to
             remove the feature once the measurement is done. Labels are
             deliberately plain, hardcoded, unlocalized debug text (set in
             Kotlin, not string resources) since this is not meant to stay
             in the app. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="vertical"
            android:background="@drawable/bg_card">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Diagnostics (temporary)"
                android:textColor="@color/tg_text_secondary"
                android:textStyle="bold"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/textLiveDiagLatencyCurrent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="monospace"
                android:textColor="@color/tg_text_primary"
                android:textSize="13sp"
                tools:text="Latency: 0.0 s" />

            <TextView
                android:id="@+id/textLiveDiagLatencyAverage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/tg_text_primary"
                android:textSize="13sp"
                tools:text="Average: 0.0 s" />

            <TextView
                android:id="@+id/textLiveDiagLatencyMax"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/tg_text_primary"
                android:textSize="13sp"
                tools:text="Max: 0.0 s" />

            <TextView
                android:id="@+id/textLiveDiagAudioBacklog"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="monospace"
                android:textColor="@color/tg_text_primary"
                android:textSize="13sp"
                tools:text="Audio backlog: 0.0 s" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
