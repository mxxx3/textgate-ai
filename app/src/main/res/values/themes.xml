<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Deliberately built on the PLATFORM Material theme
        (android:Theme.Material.Light), not the AndroidX/Google
        com.google.android.material library, so the app needs zero UI
        dependency beyond the Android SDK itself. Available since API 21;
        this app's minSdk is 26.
    -->
    <style name="Theme.TextGate" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/tg_primary</item>
        <item name="android:colorPrimaryDark">@color/tg_primary</item>
        <item name="android:windowBackground">@color/tg_background</item>
        <item name="android:textColorPrimary">@color/tg_text_primary</item>
        <item name="android:textColorSecondary">@color/tg_text_secondary</item>

        <!--
            API 27+ only (android:windowLayoutInDisplayCutoutMode was added
            in Android 8.1 / API 27). tools:targetApi tells Lint this is
            deliberate rather than an oversight: on the API 26 devices this
            app's minSdk still allows, the platform simply doesn't recognize
            this attribute and ignores it — no crash, it's just not applied
            there, which is fine since edge-to-edge/cutout enforcement from
            a targetSdk 35 app only happens on much newer OS versions anyway.
            On a targetSdk 35 device the window is allowed to draw under the
            camera cutout by default, and in landscape that cutout sits
            along what becomes the layout's top/leading edge. "shortEdges"
            makes that explicit and, combined with the manual WindowInsets
            padding applied in SettingsActivity.onCreate(), guarantees the
            cutout's inset is always accounted for instead of silently
            depending on default platform behavior that has been observed to
            differ by orientation on some OEM builds.
        -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>
</resources>
