<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:background="@drawable/bg_input"
    android:layout_marginTop="6dp"
    android:paddingStart="14dp"
    android:paddingEnd="8dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/textApiKeyRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/tg_text_primary"
        tools:text="•••• aB12  ·  active" />

    <Button
        android:id="@+id/buttonRemoveApiKey"
        android:layout_width="wrap_content"
        android:layout_height="36dp"
        android:background="@drawable/bg_btn_secondary"
        android:textColor="@color/tg_warning"
        android:textSize="12sp"
        android:textStyle="bold"
        android:text="@string/btn_remove_api_key" />
</LinearLayout>
