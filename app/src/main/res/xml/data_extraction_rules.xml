<?xml version="1.0" encoding="utf-8"?>
<!--
    Android 12+ (API 31+) data extraction rules, covering both cloud backup
    and device-to-device transfer. As with backup_rules.xml, this is
    belt-and-suspenders: android:allowBackup="false" already disables cloud
    backup entirely on API 31+, but device-to-device transfer (the
    cable/Wi-Fi "copy my data" flow during setup of a new phone) is governed
    separately by <device-transfer>, so we exclude everything there too —
    the encrypted API key and the user's app allow-list should never leave
    this device, including to a new device the same user sets up.
-->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapability="true">
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="." />
        <exclude domain="database" path="." />
        <exclude domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
