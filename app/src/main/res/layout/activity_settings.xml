<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/tg_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top Navigation Bar -->
        <LinearLayout
            android:id="@+id/settingsTopBar"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="12dp">

            <ImageButton
                android:id="@+id/buttonSettingsBack"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="@drawable/bg_circle_btn"
                android:src="@drawable/ic_arrow_back"
                android:tint="@color/tg_text_primary"
                android:contentDescription="@string/setup_guide_previous" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="@string/nav_tab_settings"
                android:textColor="@color/tg_text_primary"
                android:textSize="22sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- CARD 1: Tłumaczenie i Języki (Główna konfiguracja)           -->
        <!-- ============================================================ -->
        <TextView
            style="@style/TgGroupHeader"
            android:layout_marginTop="4dp"
            android:text="@string/settings_group_translation" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="14dp">

            <!-- Master Switch Row -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_master_switch"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="@color/tg_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/master_switch_label"
                        android:textSize="13sp"
                        android:textColor="@color/tg_text_secondary" />
                </LinearLayout>

                <Switch
                    android:id="@+id/switchAiEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/tg_divider" />

            <!-- Język docelowy -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bubble_language_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/tg_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/bubble_language_description"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary" />

            <Spinner
                android:id="@+id/spinnerAppLanguage"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/tg_divider" />

            <!-- Płeć użytkownika -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_user_gender"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/tg_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/user_gender_description"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary" />

            <Spinner
                android:id="@+id/spinnerUserGender"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- CARD 2: Klucz API Gemini (AI Connection)                     -->
        <!-- ============================================================ -->
        <TextView
            style="@style/TgGroupHeader"
            android:text="@string/settings_group_ai" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="14dp">

            <TextView
                style="@style/TgSectionTitle"
                android:text="@string/section_gemini_api" />

            <TextView
                android:id="@+id/textApiKeyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tg_primary"
                tools:text="3 klucze zapisane. Aktywny: •••• aB12" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="10dp">

                <Button
                    android:id="@+id/buttonGetApiKey"
                    android:layout_width="0dp"
                    android:layout_height="42dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:textColor="@color/tg_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:text="@string/btn_get_api_key" />

                <TextView
                    android:id="@+id/textToggleApiKeyInstructions"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="8dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_secondary"
                    android:textColor="@color/tg_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="@string/btn_show_api_key_instructions"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <TextView
                android:id="@+id/textApiKeyInstructionsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:padding="12dp"
                android:background="@drawable/bg_input"
                android:text="@string/api_key_instructions_body"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_saved_api_keys"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tg_text_primary" />

            <!-- Lista zapisanych kluczy -->
            <LinearLayout
                android:id="@+id/layoutApiKeyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />

            <!-- Dodawanie nowego klucza -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_add_api_key"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />

            <EditText
                android:id="@+id/editApiKey"
                android:layout_width="match_parent"
                android:layout_height="46dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/bg_input"
                android:hint="@string/hint_api_key"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:textSize="14sp"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/buttonAddApiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="@color/tg_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="18dp"
                    android:text="@string/btn_add_api_key" />

                <Button
                    android:id="@+id/buttonClearApiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:textColor="@color/tg_warning"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:text="@string/btn_clear_api_key" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- CARD 3: Mowa i Tłumaczenie Na Żywo (Audio & Live)             -->
        <!-- ============================================================ -->
        <TextView
            style="@style/TgGroupHeader"
            android:text="@string/settings_group_audio_live" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="14dp">

            <TextView
                style="@style/TgSectionTitle"
                android:text="@string/section_live_model" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/live_model_description"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary" />

            <Spinner
                android:id="@+id/spinnerLiveModel"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/tg_divider" />

            <!-- Odłączenie słuchawek -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_headset_disconnect"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/tg_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/headset_disconnect_description"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary" />

            <Spinner
                android:id="@+id/spinnerHeadsetDisconnectBehavior"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/tg_divider" />

            <!-- Tryb rejestrowania dźwięku -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_audio_capture_mode"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/tg_text_primary" />

            <Spinner
                android:id="@+id/spinnerAudioCaptureMode"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_input" />
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- CARD 4: Uprawnienia i Praca w Tle (System)                   -->
        <!-- ============================================================ -->
        <TextView
            style="@style/TgGroupHeader"
            android:text="@string/settings_group_integrations" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="14dp">

            <!-- Ułatwienia dostępu -->
            <TextView
                style="@style/TgSectionTitle"
                android:text="@string/section_accessibility_status" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="6dp">

                <TextView
                    android:id="@+id/textAccessibilityStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textSize="14sp"
                    android:textColor="@color/tg_text_primary"
                    tools:text="Włączona" />

                <Button
                    android:id="@+id/buttonOpenAccessibilitySettings"
                    android:layout_width="wrap_content"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_btn_primary"
                    android:textColor="@color/tg_on_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:paddingHorizontal="14dp"
                    android:text="@string/btn_open_accessibility_settings" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="14dp"
                android:background="@color/tg_divider" />

            <!-- Praca w tle -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/section_background_operation"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/tg_text_primary" />

            <TextView
                android:id="@+id/textBackgroundOperationStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary"
                tools:text="Może być wymagane na telefonach Xiaomi/Samsung" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/buttonOpenBatterySettings"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:background="@drawable/bg_btn_secondary"
                    android:textColor="@color/tg_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="@string/btn_open_battery_settings" />

                <Button
                    android:id="@+id/buttonOpenAutostartSettings"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:textColor="@color/tg_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="@string/btn_open_autostart_settings" />

                <Button
                    android:id="@+id/buttonOpenAppDetailsSettings"
                    android:layout_width="0dp"
                    android:layout_height="38dp"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_btn_secondary"
                    android:textColor="@color/tg_primary"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:text="@string/btn_open_app_details_settings" />
            </LinearLayout>
        </LinearLayout>

        <!-- ============================================================ -->
        <!-- CARD 5: Opcje Zaawansowane (Zwijany akordeon / Expandable)     -->
        <!-- ============================================================ -->
        <TextView
            style="@style/TgGroupHeader"
            android:text="@string/settings_group_advanced" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="24dp">

            <!-- Clickable Accordion Header -->
            <LinearLayout
                android:id="@+id/cardToggleAdvanced"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:clickable="true"
                android:focusable="true">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_advanced_toggle_title"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/tg_text_primary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_advanced_toggle_subtitle"
                        android:textSize="12sp"
                        android:textColor="@color/tg_text_secondary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/textAdvancedChevron"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:padding="8dp"
                    android:text="▼"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/tg_primary" />
            </LinearLayout>

            <!-- Expandable Content Container (collapsed by default) -->
            <LinearLayout
                android:id="@+id/layoutAdvancedSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone"
                android:layout_marginTop="10dp">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginBottom="12dp"
                    android:background="@color/tg_divider" />

                <!-- Model tekstowy Gemini -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_model"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/tg_text_primary" />

                <EditText
                    android:id="@+id/editModel"
                    android:layout_width="match_parent"
                    android:layout_height="46dp"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_input"
                    android:hint="@string/hint_model"
                    android:inputType="text"
                    android:textSize="14sp"
                    android:maxLines="1" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/model_suggestions_label"
                    android:textSize="12sp"
                    android:textColor="@color/tg_text_secondary" />

                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/layoutModelSuggestions"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal" />
                </HorizontalScrollView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <Button
                        android:id="@+id/buttonTestApi"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_btn_primary"
                        android:textColor="@color/tg_on_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:text="@string/btn_test_api" />

                    <TextView
                        android:id="@+id/textTestApiResult"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:textSize="12sp"
                        android:textColor="@color/tg_text_secondary" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/tg_divider" />

                <!-- Dozwolone aplikacje -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/section_allowed_apps"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/tg_text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="@string/allowed_apps_description"
                    android:textSize="12sp"
                    android:textColor="@color/tg_text_secondary" />

                <TextView
                    android:id="@+id/textToggleAdvancedApps"
                    android:layout_width="wrap_content"
                    android:layout_height="36dp"
                    android:layout_marginTop="8dp"
                    android:paddingHorizontal="12dp"
                    android:gravity="center"
                    android:background="@drawable/bg_btn_secondary"
                    android:text="@string/btn_show_advanced_apps"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:textColor="@color/tg_primary"
                    android:clickable="true"
                    android:focusable="true" />

                <TextView
                    android:id="@+id/textAdvancedAppsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/allowed_apps_advanced_hint"
                    android:textSize="12sp"
                    android:textColor="@color/tg_text_secondary"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/layoutAppList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="8dp"
                    android:visibility="gone" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginVertical="14dp"
                    android:background="@color/tg_divider" />

                <!-- Informacje i Polityka prywatności -->
                <TextView
                    android:id="@+id/textVersion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="@color/tg_text_secondary"
                    tools:text="Version 2.0.14" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <Button
                        android:id="@+id/buttonShowTutorial"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginEnd="8dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:textColor="@color/tg_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        tools:text="Pokaż samouczek" />

                    <Button
                        android:id="@+id/buttonFullPrivacyPolicy"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_btn_secondary"
                        android:textColor="@color/tg_primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:paddingHorizontal="14dp"
                        android:text="@string/btn_full_privacy_policy" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
