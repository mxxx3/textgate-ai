<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
        Deliberately built on the PLATFORM Material theme
        (android:Theme.Material.Light.NoActionBar), not the AndroidX/Google
        com.google.android.material library, so the app needs zero UI
        dependency beyond the Android SDK itself. Available since API 21;
        this app's minSdk is 26.

        NoActionBar eliminates the legacy dark green top bar, recovering
        full vertical screen real estate for translations and conversation.
    -->
    <style name="Theme.TextGate" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/tg_primary</item>
        <item name="android:colorPrimaryDark">@color/tg_primary_dark</item>
        <item name="android:windowBackground">@color/tg_background</item>
        <item name="android:textColorPrimary">@color/tg_text_primary</item>
        <item name="android:textColorSecondary">@color/tg_text_secondary</item>
        <item name="android:windowLightStatusBar">true</item>

        <!--
            API 27+ only (android:windowLayoutInDisplayCutoutMode was added
            in Android 8.1 / API 27). tools:targetApi tells Lint this is
            deliberate rather than an oversight.
        -->
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="27">shortEdges</item>
    </style>
    <style name="Theme.TextGate.SetupGuide" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@android:color/transparent</item>
        <item name="android:windowIsTranslucent">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowDisablePreview">true</item>
        <item name="android:colorAccent">@color/tg_primary</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:backgroundDimEnabled">false</item>
    </style>
</resources>
