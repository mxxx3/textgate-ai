<?xml version="1.0" encoding="utf-8"?>
<!-- "Tłumacz" tab — Modern Material 3 UI. Reuses the existing text-translation
     pipeline (see TranslateTabController / TranslationOrchestrator) unchanged;
     this file is presentation only. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/translateRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tg_background"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <!-- Top Language Selector Capsule -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_pill_container"
        android:elevation="1dp">

        <Spinner
            android:id="@+id/spinnerSourceLanguage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:dropDownWidth="240dp" />

        <ImageButton
            android:id="@+id/buttonSwapLanguages"
            android:layout_width="38dp"
            android:layout_height="38dp"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:background="@drawable/bg_circle_btn"
            android:src="@drawable/ic_swap"
            android:contentDescription="@string/translate_swap_content_description" />

        <Spinner
            android:id="@+id/spinnerTargetLanguage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:dropDownWidth="240dp" />
    </LinearLayout>

    <!-- Source Input Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="1dp">

        <TextView
            style="@style/TgCardLabel"
            android:text="@string/translate_label_source" />

        <EditText
            android:id="@+id/editSourceText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minLines="4"
            android:maxLines="8"
            android:gravity="top|start"
            android:background="@null"
            android:hint="@string/translate_hint_source"
            android:textColor="@color/tg_text_primary"
            android:textColorHint="@color/tg_text_secondary"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.2"
            android:inputType="textMultiLine|textCapSentences"
            android:importantForAutofill="no" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <ImageButton
                android:id="@+id/buttonClearSource"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_btn"
                android:src="@drawable/ic_clear"
                android:tint="@color/tg_text_secondary"
                android:contentDescription="@string/translate_clear_content_description" />

            <ImageButton
                android:id="@+id/buttonMicInput"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_primary"
                android:src="@drawable/ic_mic"
                android:tint="@color/tg_on_primary"
                android:elevation="2dp"
                android:contentDescription="@string/translate_mic_content_description" />
        </LinearLayout>
    </LinearLayout>

    <!-- Translation Output Card -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        android:background="@drawable/bg_card"
        android:elevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/TgCardLabelPrimary"
                android:text="@string/translate_label_target" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <ProgressBar
                android:id="@+id/progressTranslating"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:indeterminateTint="@color/tg_primary"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/textTranslationResult"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:scrollbars="vertical"
            android:textColor="@color/tg_text_primary"
            android:textSize="16sp"
            android:lineSpacingMultiplier="1.25"
            android:hint="@string/translate_hint_result"
            android:textColorHint="@color/tg_text_secondary" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="end|center_vertical">

            <ImageButton
                android:id="@+id/buttonCopyResult"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:background="@drawable/bg_circle_btn"
                android:src="@drawable/ic_copy"
                android:tint="@color/tg_primary"
                android:contentDescription="@string/translate_copy_content_description" />

            <ImageButton
                android:id="@+id/buttonSpeakResult"
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle_btn"
                android:src="@drawable/ic_speaker"
                android:tint="@color/tg_primary"
                android:contentDescription="@string/translate_speak_content_description" />
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
