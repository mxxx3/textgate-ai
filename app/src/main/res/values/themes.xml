<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Deliberately built on the PLATFORM Material theme
        (android:Theme.Material.Light), not the AndroidX/Google
        com.google.android.material library, so the app needs zero UI
        dependency beyond the Android SDK itself. Available since API 21;
        this app's minSdk is 26.
    -->
    <style name="Theme.TextGate" parent="android:Theme.Material.Light.DarkActionBar">
        <item name="android:colorPrimary">@color/tg_primary</item>
        <item name="android:colorPrimaryDark">@color/tg_primary</item>
        <item name="android:windowBackground">@color/tg_background</item>
        <item name="android:textColorPrimary">@color/tg_text_primary</item>
        <item name="android:textColorSecondary">@color/tg_text_secondary</item>
    </style>
</resources>
