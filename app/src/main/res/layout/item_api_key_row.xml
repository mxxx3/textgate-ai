<?xml version="1.0" encoding="utf-8"?>
<!--
    One row in the "Saved API keys" list (see SettingsActivity.renderApiKeyList).
    Shows only the key's last 4 characters (never the full key again once
    saved — see SecureApiKeyStore's doc comment) plus, when this is the
    currently active key that KeyRotationTranslator is using, a visible
    "(active)" marker. The remove button is a real Button (not a smaller
    clickable TextView like elsewhere in this screen) so it stays an easy,
    unambiguous tap target — removing the wrong key is exactly the kind of
    mistake a cramped tap target invites.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingTop="8dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/textApiKeyRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textSize="14sp"
        android:textColor="@color/tg_text_primary"
        tools:text="•••• aB12  ·  active" />

    <Button
        android:id="@+id/buttonRemoveApiKey"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/btn_remove_api_key" />
</LinearLayout>
