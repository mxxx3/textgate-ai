<?xml version="1.0" encoding="utf-8"?>
<!-- Root shell for the v2 bottom-navigation UI (Tłumacz / Rozmowa / Na żywo
     / Ustawienia) — Modern Material 3 UI. Zero external dependencies. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootContainer"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/tg_background">

    <FrameLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include
            android:id="@+id/contentTranslate"
            layout="@layout/content_translate" />

        <include
            android:id="@+id/contentConversation"
            layout="@layout/content_conversation"
            android:visibility="gone" />

        <include
            android:id="@+id/contentLive"
            layout="@layout/content_live"
            android:visibility="gone" />

    </FrameLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/tg_divider" />

    <!-- Material 3 Bottom Navigation Bar -->
    <LinearLayout
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@color/tg_card_bg"
        android:paddingTop="6dp"
        android:paddingBottom="6dp"
        android:elevation="4dp">

        <!-- Tab: Tłumacz -->
        <LinearLayout
            android:id="@+id/navTranslate"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:id="@+id/navTranslatePill"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/navTranslateIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_translate"
                    android:contentDescription="@string/nav_tab_translate" />
            </FrameLayout>

            <TextView
                android:id="@+id/navTranslateLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_tab_translate"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Tab: Rozmowa -->
        <LinearLayout
            android:id="@+id/navConversation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:id="@+id/navConversationPill"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/navConversationIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_conversation"
                    android:contentDescription="@string/nav_tab_conversation" />
            </FrameLayout>

            <TextView
                android:id="@+id/navConversationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_tab_conversation"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Tab: Na żywo -->
        <LinearLayout
            android:id="@+id/navLive"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:id="@+id/navLivePill"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/navLiveIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_live"
                    android:contentDescription="@string/nav_tab_live" />
            </FrameLayout>

            <TextView
                android:id="@+id/navLiveLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_tab_live"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

        <!-- Tab: Ustawienia -->
        <LinearLayout
            android:id="@+id/navSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:clickable="true"
            android:focusable="true"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:paddingTop="4dp"
            android:paddingBottom="4dp">

            <FrameLayout
                android:id="@+id/navSettingsPill"
                android:layout_width="56dp"
                android:layout_height="32dp"
                android:layout_gravity="center">

                <ImageView
                    android:id="@+id/navSettingsIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_nav_settings"
                    android:contentDescription="@string/nav_tab_settings" />
            </FrameLayout>

            <TextView
                android:id="@+id/navSettingsLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/nav_tab_settings"
                android:textSize="11sp"
                android:fontFamily="sans-serif-medium" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
