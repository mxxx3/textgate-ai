<?xml version="1.0" encoding="utf-8"?>
<!--
    Layout for the floating long-press translation bubble
    (TranslationBubble.kt). Both the outer LinearLayout and every view
    inside it are wrap_content — this is what gives the bubble its dynamic
    sizing requirement: a short translation produces a small bubble, a long
    one grows (up to the ScrollView's maxHeight, after which it scrolls
    internally) — it never takes a fixed or full-screen size.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="top"
    android:background="@drawable/bg_bubble"
    android:elevation="8dp">

    <ScrollView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:maxHeight="240dp"
        android:scrollbars="vertical"
        android:fillViewport="false">

        <TextView
            android:id="@+id/textBubbleContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:maxWidth="260dp"
            android:textSize="14sp"
            android:textColor="@color/tg_bubble_text"
            android:lineSpacingExtra="2dp" />
    </ScrollView>

    <ImageView
        android:id="@+id/buttonBubbleClose"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="1dp"
        android:src="@drawable/ic_bubble_close"
        android:contentDescription="@string/bubble_close_content_description"
        android:clickable="true"
        android:focusable="true" />
</LinearLayout>
