<?xml version="1.0" encoding="utf-8"?>
<!--
    PERMISSION AUDIT (see README.md "Permissions" section for full detail):

    android.permission.INTERNET
        Required for every HTTPS/WebSocket call this app ever makes — the
        text-translation POST to the Gemini API host, and (as of v2) the
        Gemini Live API WebSocket connection for Rozmowa/Na żywo — both
        restricted in software to NetworkAllowlist.GEMINI_HOST regardless
        of this broad, process-wide OS grant (Android has no per-component
        INTERNET permission).

    android.permission.RECORD_AUDIO (v2)
        Required for the Rozmowa and Na żywo voice-translation modes to
        capture microphone audio. Never requested at app launch — only
        requested the first time the user opens Rozmowa or Na żywo and
        presses START, exactly when it is actually needed.

    android.permission.FOREGROUND_SERVICE (v2)
        Required to run LiveTranslationService (the Na żywo ambient
        session) as a foreground service at all, so it survives
        screen-off/backgrounding — see that service's own class doc.

    android.permission.FOREGROUND_SERVICE_MICROPHONE (v2)
        Android 14+'s mandatory, specific foreground-service TYPE
        permission for any foreground service that captures microphone
        audio (a plain FOREGROUND_SERVICE grant is no longer sufficient on
        its own) — required for the Android 16 target in this manifest.

    android.permission.POST_NOTIFICATIONS (v2)
        Required (Android 13+) to show LiveTranslationService's persistent
        "Live session active" notification — the user's second of three
        always-visible signals that the mic is active (alongside the Na
        żywo screen itself and Android's own system mic indicator). Runtime
        permission, requested only when the user first starts Na żywo.

    android.permission.WAKE_LOCK (v2)
        A normal, install-time-granted permission (no runtime prompt) —
        required simply to be ALLOWED to call PowerManager.WakeLock.acquire()
        at all. LiveTranslationService.acquireWakeLock() takes a
        PARTIAL_WAKE_LOCK (CPU only, screen stays off — see that method's own
        doc) for the duration of an active Na żywo session. Without this
        declared, acquire() throws SecurityException and crashes the
        Foreground Service the moment a session starts — this was missing in
        the initial v2.0.0 drop and is the fix for that crash.

    android.permission.MODIFY_AUDIO_SETTINGS (v2)
        Another normal, install-time-granted permission (no runtime prompt).
        Required by AudioManager.setSpeakerphoneOn()/setCommunicationDevice(),
        which LiveTranslationController and ConversationTabController's
        applyCommunicationRouting() call to force loudspeaker output once
        AudioManager.mode is switched to MODE_IN_COMMUNICATION — without it,
        those calls can silently no-op or throw (caught defensively, so no
        crash, but the forced routing never actually applies) on devices
        that enforce it. See both controllers' applyCommunicationRouting()
        doc comments for the full story.

    In particular this app still requests NONE of: contacts, SMS, call
    logs, location, camera, storage, phone state, or QUERY_ALL_PACKAGES.
    The accessibility capability itself is not a manifest permission the
    app requests — it is a system-mediated grant the user enables manually
    in Settings, scoped by accessibility_service_config.xml below.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />

    <!--
        Declarative package-visibility filter (Android 11+ / API 30+).
        This lets SettingsActivity list installed, user-launchable apps for
        the allow-list screen WITHOUT requesting the QUERY_ALL_PACKAGES
        permission, which Play Policy restricts and which would let this
        app see the full list of every package installed on the device
        (far more than it needs). Only apps that expose a launcher icon are
        visible through this filter.
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".TextGateApplication"
        android:allowBackup="false"
        android:fullBackupContent="@xml/backup_rules"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:theme="@style/Theme.TextGate"
        android:supportsRtl="true">

        <!--
            Only launcher entry point, as of v2 (previously SettingsActivity
            — see that Activity's own doc comment). Hosts the bottom
            navigation (Tłumacz / Rozmowa / Na żywo / Ustawienia).
            exported="true" is required for the system launcher to start
            it; it does not accept any external Intent data or deep link
            (no intent-filter data scheme is declared), so there is no
            intent-injection surface here beyond "start the app," which is
            the intended behavior of a launcher activity.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            As of v2, reached only from MainActivity's "Ustawienia" tab —
            no longer the launcher. exported="false" is correct and safe:
            nothing outside this app has any legitimate reason to start it
            directly, same reasoning as AccessibilityDisclosureActivity
            below.
        -->
        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize" />

        <!--
            Google Play's mandatory "prominent disclosure" screen for the
            Accessibility Service below (see section 0 of
            docs/publikacja_google_play.md, and this Activity's own doc
            comment). Not a launcher entry point — it is only ever started
            from SettingsActivity (reached via MainActivity's Ustawienia
            tab), so it declares no intent-filter.
            exported="false" is correct and safe here: nothing outside this
            app has any legitimate reason to start it directly.
        -->
        <activity
            android:name=".accessibility.AccessibilityDisclosureActivity"
            android:exported="false"
            android:label="@string/accessibility_disclosure_title" />

        <!--
            The accessibility service. android:exported="true" is mandatory
            here: Android will not bind a service the OS Accessibility
            framework cannot see. It is safe because:
              1. android:permission binds it exclusively to the platform's
                 BIND_ACCESSIBILITY_SERVICE permission, which only the
                 system holds — no other app, however privileged, can bind
                 to or start this service.
              2. It declares no other intent-filter, so it cannot be
                 triggered by an arbitrary broadcast or activity Intent.
              3. accessibility_service_config.xml further restricts exactly
                 which event types and window-retrieval flags it receives.
        -->
        <service
            android:name=".accessibility.TextGateAccessibilityService"
            android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!--
            The Na żywo ambient Live-translation Foreground Service (v2) —
            see LiveTranslationService's own class doc for its full
            lifecycle. android:foregroundServiceType="microphone" is the
            Android 14+/16 mandatory declaration for any foreground service
            that captures microphone audio, paired with the
            FOREGROUND_SERVICE_MICROPHONE permission above. exported="false":
            only ever started from within this app (MainActivity's Na żywo
            tab, or this service's own notification's STOP/retry actions),
            after an explicit user START — never from another app, boot, or
            any external Intent.
        -->
        <service
            android:name=".live.LiveTranslationService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
