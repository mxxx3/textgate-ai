<?xml version="1.0" encoding="utf-8"?>
<!--
    Background for the floating long-press translation bubble
    (TranslationBubble.kt). Uses the app's own primary brand color as a
    solid fill so the bubble reads clearly as "this is TextGate AI" no
    matter which app it is floating over, with a rounded shape distinct
    from the flat-card look used inside the app's own Settings screen
    (see bg_card.xml) — this needs to look like a transient overlay, not
    a piece of the host app's UI.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/tg_primary" />
    <corners android:radius="16dp" />
    <padding
        android:left="14dp"
        android:top="10dp"
        android:right="14dp"
        android:bottom="10dp" />
</shape>
