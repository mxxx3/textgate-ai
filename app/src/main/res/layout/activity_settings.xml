<?xml version="1.0" encoding="utf-8"?>
<!-- v2: reorganized into labeled sections (Tłumaczenie / Audio i Live / AI
     / Integracje / Prywatność / Zaawansowane) per the v2 rebuild spec's
     Settings-tab requirement. This is a LABELING AND GROUPING change only
     — every existing card below, and every id inside it, is byte-for-byte
     unchanged from the pre-v2 layout; only new TgGroupHeader labels were
     added above each existing card (or group of cards), plus one new card
     (the headset-disconnect-behavior setting) under "Audio i Live". No
     existing view was removed, renamed, or had its logic touched. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/tg_surface">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            style="@style/TgGroupHeader"
            android:layout_marginTop="0dp"
            android:text="@string/settings_group_translation" />

        <!-- Master switch -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/TgSectionTitle"
                android:text="@string/section_master_switch" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/master_switch_label"
                    android:textSize="16sp"
                    android:textColor="@color/tg_text_primary" />

                <Switch
                    android:id="@+id/switchAiEnabled"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/master_switch_description"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="@color/tg_divider" />

            <!-- Single language picker (v1.4.0+): choosing a language here
                 changes BOTH the long-press "translate a received message"
                 bubble's default target language AND the app's own
                 interface language together. Deliberately placed here,
                 under AI transformation, rather than as its own separate
                 card. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/bubble_language_label"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/tg_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/bubble_language_description"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />

            <Spinner
                android:id="@+id/spinnerAppLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="12dp"
                android:background="@color/tg_divider" />

            <!-- Gender preference (v1.7.0+): read ONLY by the typed-trigger
                 translation path (see TextGateAccessibilityService.confirmAndProcess
                 and AppSettingsStore.userGender's doc comments) — never by
                 the long-press "translate a received message" bubble,
                 which is why the description below spells that scope out
                 explicitly rather than leaving it implied. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_user_gender"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/tg_text_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/user_gender_description"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />

            <Spinner
                android:id="@+id/spinnerUserGender"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />
        </LinearLayout>

        <TextView
            style="@style/TgGroupHeader"
            android:text="@string/settings_group_audio_live" />

        <!-- Headset-disconnect behavior (v2, new) — see
             com.textgate.ai.model.HeadsetDisconnectBehavior's class doc for
             the full behavior and the privacy reasoning behind its
             PAUSE_TRANSLATION default. Everything else about an active Na
             żywo session (ambient language, target language, START/STOP,
             live status) lives on the Na żywo tab itself, not here — see
             live_settings_hint below — so this setting is not duplicated
             in two places. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/TgSectionTitle"
                android:text="@string/section_headset_disconnect" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/headset_disconnect_description"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />

            <Spinner
                android:id="@+id/spinnerHeadsetDisconnectBehavior"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/live_settings_hint"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary" />
        </LinearLayout>

        <TextView
            style="@style/TgGroupHeader"
            android:text="@string/settings_group_ai" />

        <!-- Gemini API key -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/TgSectionTitle"
                android:text="@string/section_gemini_api" />

            <Button
                android:id="@+id/buttonGetApiKey"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_get_api_key" />

            <TextView
                android:id="@+id/textToggleApiKeyInstructions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/btn_show_api_key_instructions"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tg_primary"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/textApiKeyInstructionsBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/api_key_instructions_body"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary"
                android:visibility="gone" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_saved_api_keys"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/api_keys_multi_description"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary" />

            <!--
                Populated at runtime by SettingsActivity.renderApiKeyList()
                with one item_api_key_row.xml per stored key, plus an empty
                label (api_keys_empty) when the list is empty — same pattern
                as layoutAppList below in this file.
            -->
            <LinearLayout
                android:id="@+id/layoutApiKeyList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="4dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/label_add_api_key"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />

            <EditText
                android:id="@+id/editApiKey"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_api_key"
                android:inputType="textPassword"
                android:importantForAutofill="no"
                android:maxLines="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="8dp">

                <Button
                    android:id="@+id/buttonAddApiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/btn_add_api_key" />

                <Button
                    android:id="@+id/buttonClearApiKey"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/btn_clear_api_key" />
            </LinearLayout>

            <TextView
                android:id="@+id/textApiKeyStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary"
                tools:text="3 keys saved. Active: •••• aB12" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginVertical="12dp"
                android:background="@color/tg_divider" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/label_model"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />

            <EditText
                android:id="@+id/editModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/hint_model"
                android:inputType="text"
                android:maxLines="1" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/model_suggestions_label"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/layoutModelSuggestions"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <Button
                android:id="@+id/buttonTestApi"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/btn_test_api" />

            <TextView
                android:id="@+id/textTestApiResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />
        </LinearLayout>

        <TextView
            style="@style/TgGroupHeader"
            android:text="@string/settings_group_integrations" />

        <!-- Accessibility status -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/TgSectionTitle"
                android:text="@string/section_accessibility_status" />

            <TextView
                android:id="@+id/textAccessibilityStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="15sp"
                android:textColor="@color/tg_text_primary"
                tools:text="Not enabled" />

            <Button
                android:id="@+id/buttonOpenAccessibilitySettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_open_accessibility_settings" />
        </LinearLayout>

        <!-- Allowed apps -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/TgSectionTitle"
                android:text="@string/section_allowed_apps" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/allowed_apps_description"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />

            <TextView
                android:id="@+id/textToggleAdvancedApps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="@string/btn_show_advanced_apps"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="@color/tg_primary"
                android:padding="4dp"
                android:clickable="true"
                android:focusable="true" />

            <TextView
                android:id="@+id/textAdvancedAppsHint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="@string/allowed_apps_advanced_hint"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/layoutAppList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="8dp"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            style="@style/TgGroupHeader"
            android:text="@string/settings_group_privacy" />

        <!-- Privacy -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/TgSectionTitle"
                android:text="@string/section_privacy" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_notice_headline"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="@color/tg_primary" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/privacy_notice_body"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary" />

            <Button
                android:id="@+id/buttonFullPrivacyPolicy"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/btn_full_privacy_policy" />
        </LinearLayout>

        <TextView
            style="@style/TgGroupHeader"
            android:text="@string/settings_group_advanced" />

        <!-- About -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_card"
            android:layout_marginBottom="12dp">

            <TextView
                style="@style/TgSectionTitle"
                android:text="@string/section_about" />

            <TextView
                android:id="@+id/textVersion"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textSize="13sp"
                android:textColor="@color/tg_text_secondary"
                tools:text="Version 1.0.0" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/advanced_model_hint"
                android:textSize="12sp"
                android:textColor="@color/tg_text_secondary" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
